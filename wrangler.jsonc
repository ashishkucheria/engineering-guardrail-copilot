{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "engineering-guardrail-copilot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // The React build is served as static assets. Unknown paths fall back to index.html,
    // and only /api/* reaches the Worker first.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guardrail-copilot",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
