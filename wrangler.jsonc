{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "engineering-guardrail-copilot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // The React build is served as static assets. Unknown paths fall back to index.html,
    // and only /api/* reaches the Worker first.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guardrail-copilot",
      "migrations_dir": "migrations"
    }
  ],
  // Llama 3.3 on Workers AI. Always runs remotely, also in local dev (it needs `wrangler login`).
  "ai": { "binding": "AI", "remote": true },
  // The review pipeline: one instance per review, with the review id as the instance id.
  "workflows": [
    { "name": "guardrail-review", "binding": "REVIEW_WORKFLOW", "class_name": "ReviewWorkflow" }
  ],
  // Per-client burst limits, keyed by CF-Connecting-IP (design §10). Approximate and per
  // Cloudflare location: they smooth bursts; the daily budget below is the cost guarantee.
  "ratelimits": [
    { "name": "RL_REVIEW", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_LLM", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_API", "namespace_id": "2003", "simple": { "limit": 60, "period": 60 } },
    // Polling one review (GET /api/reviews/:id) has its own, looser limit: the UI polls every 2 s,
    // about 30 requests a minute per open review, so a few tabs or people behind one NAT fit.
    { "name": "RL_POLL", "namespace_id": "2004", "simple": { "limit": 150, "period": 60 } }
  ],
  "vars": {
    // workers-ai: real model. fake: a deterministic stand-in for tests and CI (no AI calls, no cost).
    // off: no AI; LLM standards are reported as unchecked, so the verdict is "incomplete".
    "LLM_MODE": "workers-ai",
    // Strict daily caps on model calls (design §10), sized for the Workers AI free allocation of
    // 10,000 neurons a day: one call is roughly 250 neurons, so about 40 calls a day in total.
    "DAILY_LLM_CALLS_APP": "20",
    "DAILY_LLM_CALLS_EVAL": "25"
  },
  "observability": { "enabled": true }
}
